{
  "manifest_version": 3,
  "name": "PaperClip",
  "version": "1.2.2",
  "description": "Your new tab page becomes a Zotero-style library of every academic paper you've ever opened. Auto-captures and enriches with metadata.",
  "permissions": ["tabs", "activeTab", "storage", "unlimitedStorage", "scripting", "offscreen"],
  "host_permissions": [
    "https://export.arxiv.org/*",
    "https://api.semanticscholar.org/*",
    "https://api.openreview.net/*",
    "https://api.crossref.org/*",
    "https://ieeexplore.ieee.org/*",
    "https://*.idm.oclc.org/*"
  ],
  "chrome_url_overrides": { "newtab": "index.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "PaperClip",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
